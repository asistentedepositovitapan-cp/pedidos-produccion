rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ítems agregados y nombres editados desde la app: todos los usuarios logueados los leen,
    // pero SOLO el administrador puede crearlos, cambiarlos o quitarlos.
    // (Si sumás otro administrador, agregá su correo en esta lista y en ADMIN_EMAILS del index.html)
    match /catalogo_extra/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email in ['gralsantos@vitapan.com'];
    }
    match /catalogo_ediciones/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email in ['gralsantos@vitapan.com'];
    }

    // Todo lo demás (pedidos y stock): cualquier usuario logueado, como hasta ahora.
    match /{coleccion}/{doc=**} {
      allow read, write: if request.auth != null
                         && coleccion != 'catalogo_extra'
                         && coleccion != 'catalogo_ediciones';
    }
  }
}
